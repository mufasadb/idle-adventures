
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Dependencies
node_modules/
.claude/worktrees/

# Gas City
# .beads/ is machine-local (Dolt DB, config.yaml, metadata.json, interactions.jsonl,
# runtime state); beads data syncs via `bd dolt push`, not git. Only these are tracked:
.beads/*
!.beads/.gitignore
!.beads/README.md
!.beads/hooks/
!.beads/identity.toml
.gc/
.codex/hooks.json
.agents/skills/.gc-skill-ownership.json
.agents/skills/core.gc-*
.claude/skills/.gc-skill-ownership.json
.claude/skills/core.gc-*
.beads.gate.lock
.beads.gate.lock.info
